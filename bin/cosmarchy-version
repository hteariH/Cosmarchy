#!/bin/bash

# Report the installed Cosmarchy version, plus the git ref when the install
# is tracking the repository (which is the normal case).
COSMARCHY_PATH="${COSMARCHY_PATH:-$HOME/.local/share/cosmarchy}"

version="unknown"
if [[ -f "$COSMARCHY_PATH/VERSION" ]]; then
  version="$(<"$COSMARCHY_PATH/VERSION")"
fi

ref=""
if [[ -d "$COSMARCHY_PATH/.git" ]] && command -v git >/dev/null 2>&1; then
  ref="$(git -C "$COSMARCHY_PATH" describe --tags --always --dirty 2>/dev/null || true)"
fi

cosmic_ver=""
if command -v pacman >/dev/null 2>&1; then
  cosmic_ver="$(pacman -Q cosmic-comp 2>/dev/null | awk '{print $2}' | sed -E 's/^[0-9]+://; s/-.*//' || true)"
fi
if [[ -z "$cosmic_ver" ]] && command -v cosmic-comp >/dev/null 2>&1; then
  cosmic_ver="$(cosmic-comp --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' | head -n1 || true)"
fi

echo "Cosmarchy Linux v${version}${ref:+ (${ref})}"
echo "Arch Linux Rolling + COSMIC ${cosmic_ver:-1.11}"

if [[ "${1:-}" == "--verbose" || "${1:-}" == "-v" ]]; then
  autotile_file="${XDG_CONFIG_HOME:-$HOME/.config}/cosmic/com.system76.CosmicComp/v1/autotile"
  if [[ -r "$autotile_file" ]]; then
    echo "Auto-tiling: $(tr -d '[:space:]' < "$autotile_file")"
  fi
  echo "Install path: $COSMARCHY_PATH"
  applied="${XDG_STATE_HOME:-$HOME/.local/state}/cosmarchy/migrations.log"
  if [[ -f "$applied" ]]; then
    echo "Migrations applied: $(awk 'NF{c++} END{print c+0}' "$applied")"
  fi
fi
