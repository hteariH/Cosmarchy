#!/bin/bash

# Cosmarchy Command Center (Super + Alt + Space)
#
# COSMIC Launcher covers app launching; this covers the system-action half:
# keybindings, manual, tiling, web apps, capture, snapshots, updates and power.
# Text-only menu rendered with gum inside cosmic-term.
set -eEo pipefail

COSMARCHY_PATH="${COSMARCHY_PATH:-$HOME/.local/share/cosmarchy}"
export PATH="$COSMARCHY_PATH/bin:$PATH"

if ! command -v gum >/dev/null 2>&1; then
  echo "gum is required for the Cosmarchy menu (pacman -S gum)." >&2
  read -rp "Press Enter to close..." _
  exit 1
fi

header() {
  clear
  gum style --border rounded --padding "0 2" --margin "1 0" --align center \
    "Cosmarchy" "$(cosmarchy-version 2>/dev/null | head -n1)"
}

choose() {
  gum choose --header "$1" --height 12 "${@:2}"
}

# --- Actions ---------------------------------------------------------------

menu_tiling() {
  local action
  action="$(choose "Tiling" "Status" "Enable auto-tiling" "Disable auto-tiling" "Toggle auto-tiling" "Back")" || return 0
  case "$action" in
    Status) cosmarchy-tiling status; gum input --placeholder "Press Enter to continue" >/dev/null ;;
    "Enable auto-tiling") cosmarchy-tiling enable; gum input --placeholder "Press Enter to continue" >/dev/null ;;
    "Disable auto-tiling") cosmarchy-tiling disable; gum input --placeholder "Press Enter to continue" >/dev/null ;;
    "Toggle auto-tiling") cosmarchy-tiling toggle; gum input --placeholder "Press Enter to continue" >/dev/null ;;
  esac
}

menu_webapp() {
  local action
  action="$(choose "Web Apps" "Add" "List" "Remove" "Back")" || return 0
  case "$action" in
    Add)
      local name url
      name="$(gum input --placeholder "Name (e.g. Linear)")" || return 0
      url="$(gum input --placeholder "https://linear.app")" || return 0
      [[ -n "$name" && -n "$url" ]] && cosmarchy-webapp add "$name" "$url"
      ;;
    List) cosmarchy-webapp list; gum input --placeholder "Press Enter to continue" >/dev/null ;;
    Remove)
      local name
      name="$(gum input --placeholder "Name of web app to remove")" || return 0
      [[ -n "$name" ]] && cosmarchy-webapp remove "$name"
      ;;
  esac
}

menu_capture() {
  local action
  action="$(choose "Screen Capture" "Annotate region (Satty)" "Region to file" "Whole screen" "Back")" || return 0
  case "$action" in
    "Annotate region (Satty)") exec cosmarchy-capture annotate ;;
    "Region to file") exec cosmarchy-capture region ;;
    "Whole screen") exec cosmarchy-capture screen ;;
  esac
}

menu_snapshot() {
  local action
  action="$(choose "Snapshots" "Create" "List" "Restore" "Back")" || return 0
  case "$action" in
    Create)
      local desc
      desc="$(gum input --placeholder "Snapshot description")" || return 0
      cosmarchy-snapshot-create "${desc:-Manual snapshot}"
      ;;
    List) cosmarchy-snapshot-list; gum input --placeholder "Press Enter to continue" >/dev/null ;;
    Restore) cosmarchy-snapshot-restore; gum input --placeholder "Press Enter to continue" >/dev/null ;;
  esac
}

menu_system() {
  local action
  action="$(choose "System" "Update everything" "COSMIC Settings" "System info" "Back")" || return 0
  case "$action" in
    "Update everything") cosmarchy-update; gum input --placeholder "Press Enter to continue" >/dev/null ;;
    "COSMIC Settings")
      if command -v cosmic-settings >/dev/null 2>&1; then
        setsid cosmic-settings >/dev/null 2>&1 &
      else
        echo "cosmic-settings is not installed."
        gum input --placeholder "Press Enter to continue" >/dev/null
      fi
      ;;
    "System info") cosmarchy-version --verbose; gum input --placeholder "Press Enter to continue" >/dev/null ;;
  esac
}

menu_power() {
  local action
  action="$(choose "Power" "Lock" "Suspend" "Log out" "Reboot" "Power off" "Back")" || return 0
  case "$action" in
    Lock) exec loginctl lock-session ;;
    Suspend) exec systemctl suspend ;;
    "Log out")
      if gum confirm "Log out now?"; then
        if command -v cosmic-osd >/dev/null 2>&1; then
          exec cosmic-osd log-out
        else
          exec loginctl terminate-user "$USER"
        fi
      fi
      ;;
    Reboot) gum confirm "Reboot now?" && exec systemctl reboot ;;
    "Power off") gum confirm "Power off now?" && exec systemctl poweroff ;;
  esac
}

# --- Main loop -------------------------------------------------------------

while true; do
  header
  choice="$(choose "What do you need?" \
    "Keybindings" "Manual" "Tiling" "Gaming" "Web App" "Capture" "Snapshot" "System" "Power" "Exit")" || exit 0

  case "$choice" in
    Keybindings) cosmarchy-keybindings ;;
    Manual) cosmarchy-manual ;;
    Tiling) menu_tiling ;;
    Gaming) cosmarchy-gaming status; gum input --placeholder "Press Enter to continue" >/dev/null ;;
    "Web App") menu_webapp ;;
    Capture) menu_capture ;;
    Snapshot) menu_snapshot ;;
    System) menu_system ;;
    Power) menu_power ;;
    Exit | "") exit 0 ;;
  esac
done
