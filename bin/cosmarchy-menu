#!/bin/bash

# Cosmarchy Menu (SSH / TTY fallback over launcher/actions.tsv)
#
# Inside COSMIC, Super+Alt+Space opens COSMIC Launcher prefilled with `c `.
# This script provides the same action catalog in a terminal or over SSH as a
# flat `gum filter` list.
set -eEo pipefail

COSMARCHY_PATH="${COSMARCHY_PATH:-$HOME/.local/share/cosmarchy}"
CATALOG="$COSMARCHY_PATH/launcher/actions.tsv"
export PATH="$PATH:$COSMARCHY_PATH/bin"

if [[ ! -r "$CATALOG" ]]; then
  echo "Cosmarchy action catalog not found at $CATALOG" >&2
  exit 1
fi

mapfile -t ids < <(tail -n +2 "$CATALOG" | cut -f1)
mapfile -t titles < <(tail -n +2 "$CATALOG" | cut -f2)
mapfile -t modes < <(tail -n +2 "$CATALOG" | cut -f4)
mapfile -t commands < <(tail -n +2 "$CATALOG" | cut -f5)

if ((${#titles[@]} == 0)); then
  echo "Cosmarchy action catalog is empty: $CATALOG" >&2
  exit 1
fi

format_entries() {
  local i
  for ((i = 0; i < ${#titles[@]}; i++)); do
    printf '%-30s  %s\n' "${titles[$i]}" "${ids[$i]%%-*}"
  done
}

if [[ "${1:-}" == "--list" || "${1:-}" == "list" || "${1:-}" == "-l" ]]; then
  format_entries
  exit 0
fi

if ! command -v gum >/dev/null 2>&1; then
  echo "gum is required for the Cosmarchy menu (pacman -S gum)." >&2
  if [[ -t 0 ]]; then
    read -rp "Press Enter to close..." _
  fi
  exit 1
fi

pause_for_output() {
  echo
  gum input --placeholder "Press Enter to continue" >/dev/null || true
}

run_selected() {
  local idx="$1"
  local id="${ids[$idx]}"
  local mode="${modes[$idx]}"
  local command_str="${commands[$idx]}"
  local -a cmd_parts=()
  read -r -a cmd_parts <<<"$command_str"

  if ((${#cmd_parts[@]} == 0)); then
    echo "Empty command for action $id" >&2
    return 1
  fi

  case "$mode" in
    notify)
      "${cmd_parts[@]}" || true
      pause_for_output
      ;;
    run)
      if [[ "$id" == "system-settings" ]]; then
        if command -v cosmic-settings >/dev/null 2>&1; then
          setsid cosmic-settings >/dev/null 2>&1 &
        else
          echo "cosmic-settings is not installed."
          pause_for_output
        fi
      elif [[ "$id" == power-* ]]; then
        exec "${cmd_parts[@]}"
      else
        if ! "${cmd_parts[@]}"; then
          pause_for_output
        fi
      fi
      ;;
    terminal)
      "${cmd_parts[@]}" || true
      case "$id" in
        keybindings | manual | power-*) ;;
        *) pause_for_output ;;
      esac
      ;;
    *)
      echo "Unknown action mode '$mode' for $id" >&2
      pause_for_output
      ;;
  esac
}

while true; do
  clear || true
  gum style --border rounded --padding "0 2" --margin "1 0" --align center \
    "Cosmarchy" "$(cosmarchy-version 2>/dev/null | head -n1 || true)"

  choice="$(format_entries | gum filter \
    --header "Cosmarchy Actions" \
    --placeholder "type to filter..." \
    --height 18)" || exit 0
  [[ -z "$choice" ]] && exit 0

  matched=-1
  for ((i = 0; i < ${#titles[@]}; i++)); do
    line="$(printf '%-30s  %s' "${titles[$i]}" "${ids[$i]%%-*}")"
    if [[ "$choice" == "$line" ]]; then
      matched=$i
      break
    fi
  done

  if ((matched < 0)); then
    echo "Unknown selection: $choice" >&2
    pause_for_output
    continue
  fi

  run_selected "$matched"
done
