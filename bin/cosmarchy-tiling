#!/bin/bash

# Cosmarchy tiling
#
# Toggles COSMIC's built-in automatic window tiling by writing
# ~/.config/cosmic/com.system76.CosmicComp/v1/autotile (true/false).
# cosmic-comp watches the file and applies changes immediately.
#
#   enable   turn automatic tiling on (autotile = true)
#   disable  turn automatic tiling off (autotile = false)
#   toggle   flip automatic tiling between on and off
#   status   show the current autotile state and behavior
set -eEo pipefail

COSMARCHY_PATH="${COSMARCHY_PATH:-$HOME/.local/share/cosmarchy}"
source "$COSMARCHY_PATH/install/helpers/cosmic.sh"

COMP_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/cosmic/com.system76.CosmicComp/v1"
AUTOTILE_FILE="$COMP_DIR/autotile"
BEHAVIOR_FILE="$COMP_DIR/autotile_behavior"

info() { echo -e "\033[1;36m$1\033[0m"; }
good() { echo -e "\033[1;32m  $1\033[0m"; }

read_autotile() {
  if [[ -r "$AUTOTILE_FILE" ]]; then
    tr -d '[:space:]' < "$AUTOTILE_FILE"
  else
    echo "false"
  fi
}

read_behavior() {
  if [[ -r "$BEHAVIOR_FILE" ]]; then
    tr -d '[:space:]' < "$BEHAVIOR_FILE"
  else
    echo "Global"
  fi
}

set_autotile() {
  local value="$1"
  cosmarchy_cosmic_write "com.system76.CosmicComp" "autotile" "$value"
}

case "${1:-status}" in
  enable | on)
    info "Enabling COSMIC automatic tiling"
    set_autotile "true"
    good "Auto-tiling enabled (autotile = true)"
    echo
    echo "  Super + Y                 toggle tiling for the current workspace"
    echo "  Super + G                 float or tile the focused window"
    echo "  Super + O                 toggle tiling orientation"
    echo "  Super + S                 toggle window stacking"
    echo "  Super + Shift + arrows    move the focused window"
    echo "  Super + R                 resize the focused window"
    ;;

  disable | off)
    info "Disabling COSMIC automatic tiling"
    set_autotile "false"
    good "Auto-tiling disabled (autotile = false)"
    echo "  'cosmarchy tiling enable' turns it back on."
    ;;

  toggle)
    if [[ "$(read_autotile)" == "true" ]]; then
      set_autotile "false"
      good "Auto-tiling disabled (autotile = false)"
    else
      set_autotile "true"
      good "Auto-tiling enabled (autotile = true)"
    fi
    ;;

  status)
    current="$(read_autotile)"
    behavior="$(read_behavior)"
    if [[ "$current" == "true" ]]; then
      echo "Tiling: on (COSMIC autotile)"
    else
      echo "Tiling: off (COSMIC autotile)"
    fi
    echo "  autotile:          $current"
    echo "  autotile_behavior: $behavior"
    echo "  shortcut:          Super + Y (per-workspace toggle)"
    echo
    echo "Switch with: cosmarchy tiling <enable|disable|toggle>"
    ;;

  *)
    echo "Usage: cosmarchy tiling <enable|disable|toggle|status>"
    echo
    echo "  enable    turn COSMIC automatic tiling on (default)"
    echo "  disable   turn automatic tiling off"
    echo "  toggle    flip automatic tiling on/off"
    echo "  status    show current autotile settings"
    exit 1
    ;;
esac
