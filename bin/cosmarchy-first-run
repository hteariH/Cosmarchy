#!/bin/bash

# Cosmarchy first-run session hardware setup
#
# COSMIC desktop configuration lives in plain RON files deployed directly during
# install, so this script handles only hardware work that requires a live user
# session (PipeWire / seat), then removes its own autostart entry. It is
# idempotent and safe to re-run by hand:  cosmarchy first-run
set -eEo pipefail

COSMARCHY_PATH="${COSMARCHY_PATH:-$HOME/.local/share/cosmarchy}"
export COSMARCHY_PATH
export COSMARCHY_INSTALL="$COSMARCHY_PATH/install"
export PATH="$COSMARCHY_PATH/bin:$PATH"

AUTOSTART_FILE="$HOME/.config/autostart/cosmarchy-first-run.desktop"
STAMP="${XDG_STATE_HOME:-$HOME/.local/state}/cosmarchy/first-run.done"

# Mirror progress into the journal for headless debugging:
#   journalctl --user -t cosmarchy-first-run
trace() {
  # logger may not exist in minimal containers; journal trace is best-effort.
  logger -t cosmarchy-first-run -- "$*" 2>/dev/null || true
}

trap 'rc=$?; ((rc)) && trace "aborted with status $rc"' EXIT

trace "starting (session=${XDG_SESSION_TYPE:-unknown}, user=$(id -un))"

source "$COSMARCHY_INSTALL/helpers/presentation.sh"

cosmarchy_header "Applying Cosmarchy Session Hardware Setup"

script="$COSMARCHY_INSTALL/desktop/set-hardware-session.sh"
if [[ -f "$script" ]]; then
  trace "step set-hardware-session: running"
  # shellcheck source=/dev/null
  source "$script" || {
    trace "step set-hardware-session: FAILED"
    cosmarchy_warn "Step set-hardware-session reported an error; continuing."
  }
else
  trace "step set-hardware-session: script missing at $script"
fi

mkdir -p "$(dirname "$STAMP")"
date -Iseconds > "$STAMP"
trace "wrote stamp $STAMP"

# Remove the autostart entry so this runs only once per user.
rm -f "$AUTOSTART_FILE"
trace "completed successfully"

cosmarchy_step "Session hardware setup applied"
