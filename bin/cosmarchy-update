#!/bin/bash

# Update the Arch system and sync Cosmarchy itself.
#
# Deliberately does NOT use `set -e`: each stage is allowed to fail on its own
# and is recorded, so the run reports what actually happened. This script used
# to swallow every failure behind `|| true` and print "System up to date!"
# regardless, which hid a broken `git pull` for as long as it kept failing.

COSMARCHY_PATH="${COSMARCHY_PATH:-$HOME/.local/share/cosmarchy}"
COSMARCHY_REPO_URL="${COSMARCHY_REPO_URL:-https://github.com/hteariH/Cosmarchy.git}"

wait_if_terminal() {
  if [[ "${COSMARCHY_WAIT_ON_EXIT:-0}" == "1" && -t 0 && -t 1 ]]; then
    echo
    read -rp "Press Enter to close..." _ || true
  fi
}
trap wait_if_terminal EXIT

failures=()
note_failure() { failures+=("$1"); }

step() { echo -e "\n\033[1;36m==> $1\033[0m"; }
warn() { echo -e "\033[1;33m    $1\033[0m"; }
good() { echo -e "\033[1;32m    $1\033[0m"; }

# --- A root that survives the reboot ----------------------------------------
# On a snapshot boot, or after a restore and before the reboot, the root is
# thrown away and the ESP is not: an upgrade would leave the next boot with a
# kernel and no modules. The guard prints why; nothing below runs.
# Keyed on lib/guard.sh, not the binary: boot tooling deployed before the guard
# existed would answer "must run as root" and block every update, including
# the one that deploys the guard.
BOOT_GUARD=/usr/local/lib/cosmarchy/boot/cosmarchy-boot
if [[ -f /usr/local/lib/cosmarchy/boot/lib/guard.sh ]] && ! "$BOOT_GUARD" guard; then
  echo -e "\033[1;31m✗ Nothing was updated.\033[0m"
  exit 1
fi

command -v cosmarchy-hook-run >/dev/null 2>&1 && cosmarchy-hook-run on-update "pre"

# --- System packages -------------------------------------------------------
step "Updating Cosmarchy System Packages"
sudo pacman -Syu --noconfirm || note_failure "pacman system upgrade"

for helper in paru yay; do
  if command -v "$helper" >/dev/null 2>&1; then
    step "Updating AUR Packages ($helper)"
    "$helper" -Sua --noconfirm || note_failure "$helper AUR upgrade"
    break
  fi
done

# --- Cosmarchy checkout ----------------------------------------------------
# The ISO deploys Cosmarchy with rsync --exclude=.git, so an ISO-installed
# machine has no repository and could never pull. Bootstrap one in place.
if [[ ! -d "$COSMARCHY_PATH/.git" ]] && command -v git >/dev/null 2>&1; then
  step "Initializing Cosmarchy Repository"
  echo "    (this install was deployed without one, so updates were impossible)"
  if git -C "$COSMARCHY_PATH" init -q &&
    git -C "$COSMARCHY_PATH" remote add origin "$COSMARCHY_REPO_URL" &&
    git -C "$COSMARCHY_PATH" fetch -q --depth=1 origin main; then
    git -C "$COSMARCHY_PATH" reset -q --hard FETCH_HEAD
    git -C "$COSMARCHY_PATH" branch -q -M main
    git -C "$COSMARCHY_PATH" branch -q --set-upstream-to=origin/main main 2>/dev/null
    good "Repository initialized"
  else
    warn "Could not initialize the repository; skipping configuration update"
    rm -rf "$COSMARCHY_PATH/.git"
    note_failure "repository initialization"
  fi
fi

if [[ -d "$COSMARCHY_PATH/.git" ]]; then
  step "Updating Cosmarchy Configurations"

  # This tree is managed, not authored. The installer chmods bin/ on every run,
  # and git tracks the executable bit, so permission-only differences used to
  # dirty the tree and then block the very pull that would fix it.
  git -C "$COSMARCHY_PATH" config core.fileMode false

  stashed=0
  if [[ -n "$(git -C "$COSMARCHY_PATH" status --porcelain 2>/dev/null)" ]]; then
    warn "Local changes found in $COSMARCHY_PATH:"
    git -C "$COSMARCHY_PATH" status --short | sed 's/^/      /'
    if git -C "$COSMARCHY_PATH" stash push -u -q -m "cosmarchy-update $(date -Iseconds)"; then
      stashed=1
      warn "Stashed them; recover with: git -C $COSMARCHY_PATH stash pop"
    else
      warn "Could not stash; the update will likely fail"
    fi
  fi

  if git -C "$COSMARCHY_PATH" pull --rebase origin main; then
    good "Configuration updated"
  else
    warn "Configuration update FAILED"
    note_failure "git pull"
    # Leave the tree as we found it rather than half-rebased.
    git -C "$COSMARCHY_PATH" rebase --abort 2>/dev/null
    if ((stashed)); then
      git -C "$COSMARCHY_PATH" stash pop -q 2>/dev/null &&
        warn "Restored your local changes"
    fi
  fi

  chmod +x "$COSMARCHY_PATH/bin"/* 2>/dev/null
fi

# --- Boot tooling ------------------------------------------------------------
# cosmarchy-boot, its snapper plugin and its pacman hooks run as root from
# root-owned copies; refresh them from the tree the pull just updated.
if [[ -f /etc/cosmarchy/boot.conf && -f "$COSMARCHY_PATH/default/boot/deploy.sh" ]]; then
  step "Updating Boot Tooling"
  if sudo bash "$COSMARCHY_PATH/default/boot/deploy.sh" &&
    sudo /usr/local/lib/cosmarchy/boot/cosmarchy-boot update; then
    good "Boot menu regenerated"
  else
    warn "Boot tooling update FAILED"
    note_failure "boot tooling"
  fi
fi

# --- Migrations ------------------------------------------------------------
# This is what carries configuration changes onto an already-installed machine.
if command -v cosmarchy-migrate >/dev/null 2>&1; then
  cosmarchy-migrate || note_failure "migrations"
fi

command -v cosmarchy-hook-run >/dev/null 2>&1 && cosmarchy-hook-run on-update "post"

# --- Report ----------------------------------------------------------------
echo
if ((${#failures[@]} == 0)); then
  echo -e "\033[1;32m✓ System up to date!\033[0m"
  exit 0
fi

echo -e "\033[1;31m✗ Update finished with ${#failures[@]} failure(s):\033[0m"
printf '    - %s\n' "${failures[@]}"
echo -e "\033[1;33m  Some parts of Cosmarchy may be out of date.\033[0m"
exit 1
