#!/bin/bash

# Cosmarchy keybindings browser
#
# Reads the active COSMIC shortcut RON files rather than printing a static list:
#   /usr/share/cosmic/com.system76.CosmicSettings.Shortcuts/v1/defaults
#   ~/.config/cosmic/com.system76.CosmicSettings.Shortcuts/v1/custom
#   ~/.config/cosmic/com.system76.CosmicSettings.Shortcuts/v1/system_actions
#
#   cosmarchy keybindings          searchable list (Super+Alt+/)
#   cosmarchy keybindings --list   plain list, for piping or grepping
#   cosmarchy keybindings reset    re-deploy Cosmarchy's default COSMIC shortcuts
set -eEo pipefail

COSMARCHY_PATH="${COSMARCHY_PATH:-$HOME/.local/share/cosmarchy}"
SYS_DIR="/usr/share/cosmic/com.system76.CosmicSettings.Shortcuts/v1"
USER_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/cosmic/com.system76.CosmicSettings.Shortcuts/v1"
SHIPPED_DIR="$COSMARCHY_PATH/default/cosmic/com.system76.CosmicSettings.Shortcuts/v1"

DEFAULTS_FILE="$SYS_DIR/defaults"
CUSTOM_FILE="$USER_DIR/custom"
[[ -f "$CUSTOM_FILE" ]] || CUSTOM_FILE="$SHIPPED_DIR/custom"

emit() { printf '%-28s  %s\n' "$1" "$2"; }

# Format a RON binding "(modifiers: [Super, Alt], key: "slash")" -> "Super + Alt + /"
format_combo() {
  local mods_raw="$1" key="$2"
  local parts=() mod
  local old_ifs="$IFS"
  IFS=','
  for mod in $mods_raw; do
    mod="${mod// /}"
    [[ -n "$mod" ]] && parts+=("$mod")
  done
  IFS="$old_ifs"

  if [[ -n "$key" ]]; then
    case "$key" in
      space) key="Space" ;;
      slash) key="/" ;;
      equal) key="=" ;;
      minus) key="-" ;;
      period) key="." ;;
      comma) key="," ;;
      [a-z]) key="${key^}" ;;
    esac
    parts+=("$key")
  fi

  local out="" p
  for p in "${parts[@]}"; do
    [[ -n "$out" ]] && out+=" + "
    out+="$p"
  done
  printf '%s' "$out"
}

format_action() {
  local action="$1" desc="$2"
  if [[ -n "$desc" ]]; then
    printf '%s' "$desc"
    return
  fi
  if [[ "$action" =~ ^Spawn\(\"(.*)\"\)$ ]]; then
    printf 'Run: %s' "${BASH_REMATCH[1]}"
  elif [[ "$action" =~ ^System\((.*)\)$ ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
  else
    printf '%s' "$action"
  fi
}

parse_ron_file() {
  local file="$1"
  [[ -r "$file" ]] || return 0
  local line mods key desc action combo label
  while IFS= read -r line; do
    [[ "$line" == *"modifiers:"* ]] || continue
    mods=""
    key=""
    desc=""
    action=""
    if [[ "$line" =~ modifiers:[[:space:]]*\[([^\]]*)\] ]]; then
      mods="${BASH_REMATCH[1]}"
    fi
    if [[ "$line" =~ key:[[:space:]]*\"([^\"]+)\" ]]; then
      key="${BASH_REMATCH[1]}"
    fi
    if [[ "$line" =~ description:[[:space:]]*Some\(\"([^\"]*)\"\) ]]; then
      desc="${BASH_REMATCH[1]}"
    fi
    if [[ "$line" =~ \):[[:space:]]*([^,]+),?[[:space:]]*$ ]]; then
      action="${BASH_REMATCH[1]}"
      action="${action%"${action##*[![:space:]]}"}"
    fi
    [[ -n "$action" && "$action" != "Disable" ]] || continue
    combo="$(format_combo "$mods" "$key")"
    label="$(format_action "$action" "$desc")"
    emit "$combo" "$label"
  done < "$file"
}

collect() {
  printf 'Cosmarchy Keybindings (COSMIC)\n'

  if [[ -r "$CUSTOM_FILE" ]]; then
    printf '\nCosmarchy & Custom Shortcuts\n'
    parse_ron_file "$CUSTOM_FILE"
  fi

  if [[ -r "$DEFAULTS_FILE" ]]; then
    printf '\nCOSMIC Defaults\n'
    parse_ron_file "$DEFAULTS_FILE"
  fi

  printf '\nConfigure shortcuts in COSMIC Settings -> Input Devices -> Keyboard -> Shortcuts.\n'
}

case "${1:-search}" in
  --list | list | -l)
    collect
    ;;

  search | "")
    if [[ -t 0 && -t 1 ]]; then
      if command -v gum >/dev/null 2>&1; then
        collect | gum filter --header "Cosmarchy Keybindings" --placeholder "type to filter..." --height 24 >/dev/null || true
      elif command -v less >/dev/null 2>&1; then
        collect | less -R
      else
        collect
      fi
    else
      collect
    fi
    ;;

  reset)
    source "$COSMARCHY_PATH/install/helpers/cosmic.sh"
    echo "Re-deploying Cosmarchy's default COSMIC shortcuts..."
    cosmarchy_cosmic_deploy "$COSMARCHY_PATH/default/cosmic/com.system76.CosmicSettings.Shortcuts" \
      "${XDG_CONFIG_HOME:-$HOME/.config}/cosmic/com.system76.CosmicSettings.Shortcuts"
    echo "COSMIC shortcuts restored."
    ;;

  *)
    echo "Usage: cosmarchy keybindings [--list|reset]"
    exit 1
    ;;
esac
