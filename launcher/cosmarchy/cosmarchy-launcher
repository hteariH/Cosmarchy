#!/usr/bin/env python3
"""Cosmarchy pop-launcher plugin.

Thin JSON-over-stdio adapter for pop-launcher 1.11 serving three surfaces
under the `c ` prefix:
  - `c <query>`      actions from launcher/actions.tsv
  - `c key <query>`  active COSMIC/Cosmarchy shortcuts via `cosmarchy-keybindings --list`
  - `c man <query>`  local manual pages via `cosmarchy-manual --list`

Never writes anything except line-delimited JSON to stdout; all diagnostics go
to stderr. Stdlib only.
"""

from __future__ import annotations

from dataclasses import dataclass
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
from typing import Any

MAX_RESULTS = 8
VALID_MODES = frozenset({"run", "notify", "terminal"})
EXPECTED_HEADER = ["id", "title", "keywords", "mode", "command"]
ANSI_ESCAPE_RE = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]")
MANUAL_LINE_RE = re.compile(r"^\s*(\d+)\s+(.+?)\s*$")

MODE_ICONS = {
    "run": "system-run",
    "notify": "dialog-information",
    "terminal": "utilities-terminal",
}

MODE_LABELS = {
    "run": "Action",
    "notify": "Status",
    "terminal": "Terminal",
}


@dataclass(frozen=True)
class Entry:
    kind: str  # "action" | "keybinding" | "manual" | "error"
    title: str
    description: str
    keywords: str
    icon: str
    mode: str = ""
    command: str = ""
    page: str = ""


def log_err(msg: str) -> None:
    print(f"cosmarchy-launcher: {msg}", file=sys.stderr, flush=True)


def emit(payload: Any) -> None:
    sys.stdout.write(json.dumps(payload, ensure_ascii=False) + "\n")
    sys.stdout.flush()


def get_cosmarchy_path() -> Path:
    raw = os.environ.get("COSMARCHY_PATH")
    if raw:
        return Path(raw)
    return Path.home() / ".local" / "share" / "cosmarchy"


def build_env(cosmarchy_path: Path, extra: dict[str, str] | None = None) -> dict[str, str]:
    env = os.environ.copy()
    bin_dir = str(cosmarchy_path / "bin")
    if os.path.isdir(bin_dir):
        current_path = env.get("PATH", "")
        parts = current_path.split(os.pathsep) if current_path else []
        if bin_dir not in parts:
            # Append rather than prepend so /usr/local/bin and test stubs win.
            env["PATH"] = os.pathsep.join([*parts, bin_dir]) if parts else bin_dir
    if extra:
        env.update(extra)
    return env


def resolve_argv(argv: list[str], env: dict[str, str]) -> list[str]:
    if not argv:
        return argv
    resolved = shutil.which(argv[0], path=env.get("PATH"))
    if resolved:
        return [resolved, *argv[1:]]
    return argv


def detach_spawn(argv: list[str], env: dict[str, str]) -> None:
    cmd = resolve_argv(argv, env)
    kwargs: dict[str, Any] = {
        "stdin": subprocess.DEVNULL,
        "stdout": subprocess.DEVNULL,
        "stderr": subprocess.DEVNULL,
        "env": env,
    }
    if os.name == "posix":
        kwargs["start_new_session"] = True
        kwargs["close_fds"] = True
    else:
        kwargs["creationflags"] = (
            getattr(subprocess, "CREATE_NEW_PROCESS_GROUP", 0)
            | getattr(subprocess, "DETACHED_PROCESS", 0)
        )
    subprocess.Popen(cmd, **kwargs)


def run_notify_helper(title: str, argv: list[str]) -> int:
    cosmarchy_path = get_cosmarchy_path()
    env = build_env(cosmarchy_path)
    cmd = resolve_argv(argv, env)
    urgency = "normal"
    try:
        proc = subprocess.run(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            encoding="utf-8",
            errors="replace",
            env=env,
            timeout=60,
        )
        raw_out = ANSI_ESCAPE_RE.sub("", proc.stdout or "").strip()
        if proc.returncode != 0:
            urgency = "critical"
            body = raw_out or f"Command exited with status {proc.returncode}"
        else:
            body = raw_out or "(no output)"
    except FileNotFoundError:
        urgency = "critical"
        body = f"Command not found: {argv[0]}"
    except subprocess.TimeoutExpired:
        urgency = "critical"
        body = f"Command timed out: {argv[0]}"
    except OSError as exc:
        urgency = "critical"
        body = str(exc)

    notify_cmd = resolve_argv(
        ["notify-send", "--app-name=Cosmarchy", "-u", urgency, title, body],
        env,
    )
    try:
        subprocess.run(
            notify_cmd,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            env=env,
            timeout=10,
        )
    except OSError as exc:
        log_err(f"notify-send failed: {exc}")
        return 1
    return 0


def load_actions(cosmarchy_path: Path) -> tuple[list[Entry], str | None]:
    catalog = cosmarchy_path / "launcher" / "actions.tsv"
    try:
        text = catalog.read_text(encoding="utf-8")
    except OSError as exc:
        reason = f"cannot read {catalog}: {exc.strerror or exc}"
        log_err(f"actions unavailable: {reason}")
        return [], reason

    lines = [line for line in text.splitlines() if line.strip()]
    if not lines:
        reason = "actions.tsv is empty"
        log_err(f"actions unavailable: {reason}")
        return [], reason

    header = lines[0].split("\t")
    if header != EXPECTED_HEADER:
        reason = f"invalid actions.tsv header: {lines[0]!r}"
        log_err(f"actions unavailable: {reason}")
        return [], reason

    entries: list[Entry] = []
    for lineno, line in enumerate(lines[1:], start=2):
        fields = line.split("\t")
        if len(fields) != 5:
            reason = f"actions.tsv line {lineno} has {len(fields)} fields (expected 5)"
            log_err(f"actions unavailable: {reason}")
            return [], reason
        action_id, title, keywords, mode, command = (f.strip() for f in fields)
        if not action_id or not title or not command:
            reason = f"actions.tsv line {lineno} has empty required field"
            log_err(f"actions unavailable: {reason}")
            return [], reason
        if mode not in VALID_MODES:
            reason = f"actions.tsv line {lineno} has invalid mode {mode!r}"
            log_err(f"actions unavailable: {reason}")
            return [], reason
        entries.append(
            Entry(
                kind="action",
                title=title,
                description=f"{MODE_LABELS[mode]} · {command}",
                keywords=f"{action_id} {keywords} {command}",
                icon=MODE_ICONS[mode],
                mode=mode,
                command=command,
            )
        )

    if not entries:
        reason = "actions.tsv defines no actions"
        log_err(f"actions unavailable: {reason}")
        return [], reason

    return entries, None


def load_keybindings(env: dict[str, str]) -> tuple[list[Entry], str | None]:
    cmd = resolve_argv(["cosmarchy-keybindings", "--list"], env)
    try:
        proc = subprocess.run(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            encoding="utf-8",
            errors="replace",
            env=env,
            timeout=10,
        )
    except FileNotFoundError:
        reason = "cosmarchy-keybindings not found on PATH"
        log_err(f"keybindings unavailable: {reason}")
        return [], reason
    except subprocess.TimeoutExpired:
        reason = "cosmarchy-keybindings --list timed out"
        log_err(f"keybindings unavailable: {reason}")
        return [], reason
    except OSError as exc:
        reason = str(exc)
        log_err(f"keybindings unavailable: {reason}")
        return [], reason

    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout or "").strip().splitlines()
        reason = detail[0] if detail else f"exited with status {proc.returncode}"
        log_err(f"keybindings unavailable: {reason}")
        return [], reason

    entries: list[Entry] = []
    section = ""
    for raw_line in proc.stdout.splitlines():
        line = raw_line.strip()
        if not line:
            continue
        if line in ("Cosmarchy & Custom Shortcuts", "COSMIC Defaults"):
            section = line
            continue
        parts = re.split(r"\s{2,}", line, maxsplit=1)
        if len(parts) != 2:
            continue
        combo, label = parts[0].strip(), parts[1].strip()
        if not combo or not label:
            continue
        entries.append(
            Entry(
                kind="keybinding",
                title=f"{combo} — {label}",
                description=section or "Keybinding",
                keywords=f"{combo} {label} {section}".strip(),
                icon="input-keyboard",
            )
        )

    if not entries:
        reason = "no keybindings returned"
        log_err(f"keybindings unavailable: {reason}")
        return [], reason

    return entries, None


def load_manual(env: dict[str, str]) -> tuple[list[Entry], str | None]:
    cmd = resolve_argv(["cosmarchy-manual", "--list"], env)
    try:
        proc = subprocess.run(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            encoding="utf-8",
            errors="replace",
            env=env,
            timeout=10,
        )
    except FileNotFoundError:
        reason = "cosmarchy-manual not found on PATH"
        log_err(f"manual unavailable: {reason}")
        return [], reason
    except subprocess.TimeoutExpired:
        reason = "cosmarchy-manual --list timed out"
        log_err(f"manual unavailable: {reason}")
        return [], reason
    except OSError as exc:
        reason = str(exc)
        log_err(f"manual unavailable: {reason}")
        return [], reason

    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout or "").strip().splitlines()
        reason = detail[0] if detail else f"exited with status {proc.returncode}"
        log_err(f"manual unavailable: {reason}")
        return [], reason

    entries: list[Entry] = []
    for raw_line in proc.stdout.splitlines():
        match = MANUAL_LINE_RE.match(raw_line)
        if not match:
            continue
        num, title = match.group(1), match.group(2)
        short_num = num.lstrip("0") or "0"
        entries.append(
            Entry(
                kind="manual",
                title=f"{num} · {title}",
                description=f"Manual page {num} · cosmarchy-manual {num}",
                keywords=f"{num} {short_num} {title}",
                icon="help-contents",
                page=num,
            )
        )

    if not entries:
        reason = "no manual pages returned"
        log_err(f"manual unavailable: {reason}")
        return [], reason

    return entries, None


def parse_query(query: str) -> tuple[str, list[str]] | None:
    if not query.startswith("c "):
        return None
    rest = query[2:].lstrip()
    lower = rest.lower()
    if lower == "key" or lower.startswith("key "):
        return "keybindings", lower[3:].split()
    if lower == "man" or lower.startswith("man "):
        return "manual", lower[3:].split()
    return "actions", lower.split()


def match_entries(entries: list[Entry], terms: list[str]) -> list[Entry]:
    if not terms:
        return entries[:MAX_RESULTS]

    matched: list[Entry] = []
    for entry in entries:
        haystack = f"{entry.title} {entry.keywords}".lower()
        if all(term in haystack for term in terms):
            matched.append(entry)

    matched.sort(key=lambda e: 0 if all(t in e.title.lower() for t in terms) else 1)
    return matched[:MAX_RESULTS]


class CosmarchyPlugin:
    def __init__(self) -> None:
        self.cosmarchy_path = get_cosmarchy_path()
        self.env = build_env(self.cosmarchy_path)

        actions, actions_err = load_actions(self.cosmarchy_path)
        keybindings, keybindings_err = load_keybindings(self.env)
        manual, manual_err = load_manual(self.env)

        self.sources: dict[str, list[Entry]] = {
            "actions": actions,
            "keybindings": keybindings,
            "manual": manual,
        }
        self.errors: dict[str, str | None] = {
            "actions": actions_err,
            "keybindings": keybindings_err,
            "manual": manual_err,
        }
        self.current_results: list[Entry] = []

    def emit_entry(self, idx: int, entry: Entry) -> None:
        keywords = entry.keywords.split() if entry.keywords else None
        emit(
            {
                "Append": {
                    "id": idx,
                    "name": entry.title,
                    "description": entry.description,
                    "keywords": keywords,
                    "icon": {"Name": entry.icon} if entry.icon else None,
                    "exec": None,
                    "window": None,
                }
            }
        )

    def handle_search(self, query: str) -> None:
        try:
            parsed = parse_query(query)
            if parsed is None:
                self.current_results = []
                return

            source, terms = parsed
            err = self.errors.get(source)
            if err is not None:
                err_entry = Entry(
                    kind="error",
                    title=f"Cosmarchy: {source} unavailable — {err}",
                    description="Check Cosmarchy installation and plugin logs",
                    keywords="",
                    icon="dialog-error",
                )
                self.current_results = [err_entry]
                self.emit_entry(0, err_entry)
                return

            results = match_entries(self.sources[source], terms)
            self.current_results = results
            for idx, entry in enumerate(results):
                self.emit_entry(idx, entry)
        except Exception as exc:  # noqa: BLE001 — never hang pop-launcher on Search
            log_err(f"search failed for {query!r}: {exc}")
            err_entry = Entry(
                kind="error",
                title=f"Cosmarchy: search unavailable — {exc}",
                description="Check plugin logs on stderr",
                keywords="",
                icon="dialog-error",
            )
            self.current_results = [err_entry]
            self.emit_entry(0, err_entry)
        finally:
            emit("Finished")

    def handle_activate(self, idx: int) -> None:
        try:
            if not (0 <= idx < len(self.current_results)):
                log_err(f"activate ignored: index {idx} out of range")
                return

            entry = self.current_results[idx]
            if entry.kind in ("keybinding", "error"):
                return

            if entry.kind == "manual":
                detach_spawn(["cosmic-term", "-e", "cosmarchy-manual", entry.page], self.env)
                return

            if entry.kind == "action":
                argv = shlex.split(entry.command)
                if not argv:
                    log_err(f"empty command for action {entry.title!r}")
                    return
                if entry.mode == "run":
                    detach_spawn(argv, self.env)
                elif entry.mode == "terminal":
                    term_env = build_env(self.cosmarchy_path, {"COSMARCHY_WAIT_ON_EXIT": "1"})
                    detach_spawn(["cosmic-term", "-e", *argv], term_env)
                elif entry.mode == "notify":
                    helper = os.path.abspath(__file__)
                    detach_spawn(
                        [sys.executable, helper, "--notify", entry.title, "--", *argv],
                        self.env,
                    )
        except Exception as exc:  # noqa: BLE001 — always reply Close
            log_err(f"activate failed for index {idx}: {exc}")
        finally:
            emit("Close")

    def serve(self) -> int:
        for raw_line in sys.stdin:
            line = raw_line.strip()
            if not line:
                continue
            try:
                req = json.loads(line)
            except json.JSONDecodeError as exc:
                log_err(f"malformed JSON request: {exc}")
                continue

            if req == "Exit":
                break
            if isinstance(req, dict):
                if "Search" in req and isinstance(req["Search"], str):
                    self.handle_search(req["Search"])
                elif "Activate" in req and isinstance(req["Activate"], int) and not isinstance(req["Activate"], bool):
                    self.handle_activate(req["Activate"])
        return 0


def main(argv: list[str]) -> int:
    if len(argv) >= 5 and argv[1] == "--notify" and argv[3] == "--":
        return run_notify_helper(argv[2], argv[4:])
    return CosmarchyPlugin().serve()


if __name__ == "__main__":
    sys.exit(main(sys.argv))
